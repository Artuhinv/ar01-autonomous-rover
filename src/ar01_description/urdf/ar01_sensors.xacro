<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ar01_sensors" params="use_sim">
    <!-- Sensor geometry is shared by the physical model and the Gazebo plugins. -->
    <xacro:property name="lidar_radius" value="0.035"/>
    <xacro:property name="lidar_height" value="0.040"/>
    <xacro:property name="lidar_mass" value="0.100"/>

    <xacro:property name="imu_length" value="0.040"/>
    <xacro:property name="imu_width" value="0.030"/>
    <xacro:property name="imu_height" value="0.015"/>
    <xacro:property name="imu_mass" value="0.020"/>

    <material name="sensor_blue">
      <color rgba="0.12 0.35 0.75 1.0"/>
    </material>
    <material name="sensor_orange">
      <color rgba="0.95 0.45 0.08 1.0"/>
    </material>

    <link name="lidar_link">
      <visual>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <material name="sensor_blue"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${lidar_mass}"/>
        <!-- Solid cylinder with its rotation axis along Z. -->
        <inertia
          ixx="${lidar_mass / 12.0 * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${lidar_mass / 12.0 * (3.0 * lidar_radius * lidar_radius + lidar_height * lidar_height)}"
          iyz="0.0"
          izz="${lidar_mass / 2.0 * lidar_radius * lidar_radius}"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="0.070 0 0.075" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
      <visual>
        <geometry>
          <box size="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
        <material name="sensor_orange"/>
      </visual>
      <collision>
        <geometry>
          <box size="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${imu_mass}"/>
        <!-- Solid box inertia about its centre. -->
        <inertia
          ixx="${imu_mass / 12.0 * (imu_width * imu_width + imu_height * imu_height)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${imu_mass / 12.0 * (imu_length * imu_length + imu_height * imu_height)}"
          iyz="0.0"
          izz="${imu_mass / 12.0 * (imu_length * imu_length + imu_width * imu_width)}"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="-0.025 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:if value="${use_sim}">
      <gazebo reference="lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0.0</min_angle>
                <max_angle>0.0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </gazebo>

      <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
          <topic>/imu/data</topic>
          <update_rate>100</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
