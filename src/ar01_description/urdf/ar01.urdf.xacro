<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ar01">
  <!--
    AR-01 design baseline v0.1

    Units: metres, kilograms, radians.
    REP-103 axes: +X forward, +Y left, +Z up.

    ros2_control and simulated sensor plugins are intentionally not included at
    this stage. This file defines only geometry, kinematics, and rigid-body data.
  -->

  <xacro:include filename="ar01_base.xacro"/>
  <xacro:include filename="ar01_sensors.xacro"/>
  <xacro:include filename="ar01_ros2_control.xacro"/>

  <xacro:arg name="use_sim" default="false"/>
  <xacro:arg name="controller_config" default=""/>

  <xacro:ar01_base/>
  <xacro:ar01_sensors use_sim="$(arg use_sim)"/>

  <xacro:if value="$(arg use_sim)">
    <xacro:ar01_ros2_control controller_config="$(arg controller_config)"/>
  </xacro:if>
</robot>
