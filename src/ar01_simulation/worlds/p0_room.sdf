<?xml version="1.0"?>
<sdf version="1.9">
  <world name="p0_room">
    <gravity>0 0 -9.81</gravity>
    <physics name="p0_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry>
            <box><size>6 6 0.10</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 6 0.10</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- Four 500 mm-high walls around the 6 x 6 m test area. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.2 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3.05 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.0 0.5</size></box></geometry></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3.05 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.0 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="box_1">
      <static>true</static>
      <pose>-1.35 1.15 0.30 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.6 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.6 0.6</size></box></geometry></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>1.55 -1.35 0.40 0 0 -0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 1.0 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 1.0 0.8</size></box></geometry></visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>1.65 1.50 0.25 0 0 0.55</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.35 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.35 0.5</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
